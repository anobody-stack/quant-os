# QuantOS environment configuration example.
# Copy this file to `.env` and fill in real values locally.
# Never commit `.env` or any file containing real secrets.

# --- Application ---
QUANT_OS_ENVIRONMENT=development
QUANT_OS_LOG_LEVEL=INFO

# --- Data providers (placeholders; no real endpoints or keys) ---
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# --- Broker / execution (placeholders) ---
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ENVIRONMENT=paper

# --- Database (placeholder) ---
DATABASE_URL=
